<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NaxEventViewer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NaxEventViewer.App"
    xmlns:core="using:NaxEventViewer.Core"
    Title="Nax Event Viewer">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="Refresh_Accelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Accelerator" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="Open_Accelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveCsv_Accelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,150,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="Nax Event Viewer" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="ElevationText" Grid.Column="2" Text="Administrator" VerticalAlignment="Center" Visibility="Collapsed"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- Search, filters and commands -->
        <Grid Grid.Row="1" Padding="12,0,8,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" MinWidth="220" VerticalAlignment="Center"
                     PlaceholderText="Search messages, sources and IDs (Ctrl+F)" TextChanged="FilterText_Changed" />
            <TextBox x:Name="EventIdBox" Grid.Column="1" Width="190" VerticalAlignment="Center"
                     PlaceholderText="Event IDs, such as 41, -7036" TextChanged="FilterText_Changed"
                     ToolTipService.ToolTip="IDs and ranges separated by commas, such as 4624, 1000-1010. A minus sign excludes an ID." />
            <ComboBox x:Name="TimeBox" Grid.Column="2" Width="150" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="TimeBox_SelectionChanged">
                <x:String>Any time</x:String>
                <x:String>Last hour</x:String>
                <x:String>Last 24 hours</x:String>
                <x:String>Last 7 days</x:String>
                <x:String>Last 30 days</x:String>
            </ComboBox>
            <CommandBar Grid.Column="4" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" VerticalAlignment="Center">
                <AppBarButton Label="Refresh" Icon="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Read the log again (F5)" />
                <AppBarToggleButton x:Name="LiveToggle" Label="Live" IsChecked="True" Click="LiveToggle_Click"
                                    ToolTipService.ToolTip="Show new events as soon as Windows writes them">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton Label="Open file" Icon="OpenFile" Click="Open_Click" ToolTipService.ToolTip="Open a saved .evtx file (Ctrl+O)" />
                <AppBarButton Label="Save" Icon="Save">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Shown events as CSV…" Click="SaveCsv_Click" KeyboardAcceleratorTextOverride="Ctrl+S" />
                            <MenuFlyoutItem x:Name="SaveEvtxItem" Text="Whole log as .evtx…" Click="SaveEvtx_Click" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="AdminButton" Label="Run as administrator" Click="Admin_Click"
                              ToolTipService.ToolTip="Restart with administrator rights, which the Security log and some other logs need">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7EF;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar x:Name="ProblemBar" Grid.Row="2" Margin="12,0,12,8" IsOpen="False" Severity="Warning" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="ProblemAdminButton" Content="Restart as administrator" Click="Admin_Click" Visibility="Collapsed" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Tree on the left; list above the detail pane on the right -->
        <Grid Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TreeView x:Name="LogTree" SelectionMode="Single" ItemInvoked="LogTree_ItemInvoked" Padding="0,6,0,0">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="local:LogNode">
                            <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource CellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <CheckBox x:Name="ShowAllLogsBox" Grid.Row="1" Margin="12,6" Content="Show empty, analytic and debug logs" Click="ShowAllLogs_Click" />
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="340" MinHeight="120" />
                </Grid.RowDefinitions>

                <Grid Margin="16,10,12,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LogTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center" />
                    <StackPanel x:Name="LevelButtons" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <!-- A shown level looks like a normal button and a hidden one fades out, instead of the bright accent of a checked toggle. -->
                        <StackPanel.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ControlFillColorDefaultBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ControlStrokeColorDefaultBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ControlStrokeColorDefaultBrush" />
                                        <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorDisabledBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ControlFillColorDefaultBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ControlStrokeColorDefaultBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ControlStrokeColorDefaultBrush" />
                                        <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorDisabledBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </StackPanel.Resources>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ColumnHeaders" Grid.Row="1" Margin="16,0,28,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LevelHeader" Content="Level" Tag="Level" Style="{StaticResource ColumnHeaderButtonStyle}" Click="ColumnHeader_Click" />
                    <Button x:Name="TimeHeader" Grid.Column="1" Content="Date and time" Tag="Time" Style="{StaticResource ColumnHeaderButtonStyle}" Click="ColumnHeader_Click" />
                    <Button x:Name="SourceHeader" Grid.Column="2" Content="Source" Tag="Source" Style="{StaticResource ColumnHeaderButtonStyle}" Click="ColumnHeader_Click" />
                    <Button x:Name="EventIdHeader" Grid.Column="3" Content="ID" Tag="EventId" Style="{StaticResource ColumnHeaderButtonStyle}" Click="ColumnHeader_Click" />
                    <Button x:Name="TaskHeader" Grid.Column="4" Content="Task category" Tag="Task" Style="{StaticResource ColumnHeaderButtonStyle}" Click="ColumnHeader_Click" />
                    <TextBlock Grid.Column="5" Text="Message" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <ListView x:Name="EventList" Grid.Row="2" SelectionMode="Extended" SelectionChanged="EventList_SelectionChanged"
                          KeyDown="EventList_KeyDown" Padding="4,0,4,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="Padding" Value="12,0,12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:EventItem">
                            <Grid Height="30" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind local:LevelVisuals.Glyph(Kind)}" Foreground="{x:Bind local:LevelVisuals.Brush(Kind)}" FontSize="14" />
                                    <TextBlock Text="{x:Bind LevelText}" Style="{StaticResource CellTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" Style="{StaticResource CellTextStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Provider}" Style="{StaticResource CellTextStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind EventIdText}" Style="{StaticResource CellTextStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind TaskName, Mode=OneWay}" Style="{StaticResource CellTextStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind MessagePreview, Mode=OneWay}" Style="{StaticResource CellTextStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />

                <!-- Detail pane: message on the left, fields on the right -->
                <Grid Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="DetailEmptyText" Text="Select an event to see its details." HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="DetailPanel" Padding="16,10,16,10" RowSpacing="6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="DetailIcon" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="DetailSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <SelectorBar x:Name="DetailTabs" Grid.Column="2" SelectionChanged="DetailTabs_SelectionChanged">
                                <SelectorBarItem x:Name="GeneralTab" Text="General" IsSelected="True" />
                                <SelectorBarItem x:Name="XmlTab" Text="XML" />
                            </SelectorBar>
                            <Button Grid.Column="3" VerticalAlignment="Center" Click="CopyDetail_Click" ToolTipService.ToolTip="Copy the event as text">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>
                        <Grid x:Name="GeneralView" Grid.Row="1" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="MessageText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Padding="0,4,12,8" />
                            </ScrollViewer>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="FieldsGrid" RowSpacing="3" Padding="0,4,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                        <ScrollViewer x:Name="XmlView" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="XmlText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" Padding="0,4,12,8" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="4" Padding="16,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="MessageStatusText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar x:Name="LoadProgress" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
