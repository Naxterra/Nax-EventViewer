<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>NaxEventViewer.App</RootNamespace>
    <AssemblyName>Nax-EventViewer</AssemblyName>
    <Product>Nax-EventViewer</Product>
    <Company>Naxterra</Company>
    <Version>0.3.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Nax-EventViewer.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Both .NET and the Windows App SDK are shipped with the app, so it runs on a PC that has neither installed. -->
    <SelfContained>true</SelfContained>
    <!-- Windows may start this app in place of eventvwr.exe. A startup hook named in the user's environment must never
         load code into it, least of all into a copy that runs with administrator rights. -->
    <StartupHookSupport>false</StartupHookSupport>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Compiled ahead of time, so a start does not wait for .NET to compile the app's and the runtime's code first. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\Nax-EventViewer.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\NaxEventViewer.Core\NaxEventViewer.Core.csproj" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <!-- Only the parts of the Windows App SDK the app uses. The whole SDK would also bring its AI and machine-learning
         components, about 40 MB that every start and every virus scan has to get past. The versions are the ones the
         Microsoft.WindowsAppSDK 2.2.0 bundle pins, so the parts always match each other. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.2.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.0.15" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.2.0" />
  </ItemGroup>

  <Target Name="CopyGeneratedXamlToPublish" AfterTargets="Publish">
    <ItemGroup>
      <GeneratedXamlResources Include="$(TargetDir)**\*.xbf" />
      <GeneratedPriResources Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(GeneratedXamlResources)" DestinationFiles="@(GeneratedXamlResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GeneratedPriResources)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
